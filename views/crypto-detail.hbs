{{!< layouts/main }}

<div class="crypto-detail-container">
    <!-- Back Button -->
    <div class="back-nav">
        <a href="/" class="back-btn">
            <i class="fas fa-arrow-left"></i> Back
        </a>
    </div>

    <!-- Main Content Grid -->
    <div class="detail-grid">
        <!-- Left Column - Chart and Info -->
        <div class="detail-main">
            <!-- Chart Section with integrated header -->
            <div class="chart-section-full card">
                <!-- Coin Info Header -->
                <div class="coin-info-header">
                    <div class="coin-info-left">
                        <img src="{{coin.image}}" alt="{{coin.name}}" class="coin-icon-small">
                        <div class="coin-info-text">
                            <h1 class="coin-name">{{coin.name}}</h1>
                            <div class="coin-meta">
                                <span class="coin-symbol-small">{{coin.symbol}}</span>
                                {{#if coin.market_cap_rank}}
                                    <span class="rank-badge-small">Rank #{{coin.market_cap_rank}}</span>
                                {{/if}}
                            </div>
                        </div>
                    </div>
                    <div class="coin-info-right">
                        <button class="icon-btn">
                            <i class="far fa-bell"></i> Create Alert
                        </button>
                        <button class="icon-btn">
                            <i class="far fa-bookmark"></i> Watchlist
                        </button>
                    </div>
                </div>

                <!-- Price Display -->
                <div class="price-display-section">
                    <div class="price-large">${{formatPrice coin.current_price}}</div>
                    <div class="price-change-inline {{#if (gt coin.price_change_percentage_24h 0)}}positive{{else}}negative{{/if}}">
                        {{#if (gt coin.price_change_percentage_24h 0)}}+{{/if}}{{formatPrice coin.price_change_24h}} ({{#if (gt coin.price_change_percentage_24h 0)}}+{{/if}}{{formatPrice coin.price_change_percentage_24h}}%) 1D
                    </div>
                </div>

                <!-- Chart Container -->
                <div class="chart-container-detail">
                    <canvas id="detailChart"></canvas>
                    <div id="chartLoading" class="chart-loading">
                        <div class="spinner"></div>
                        <span>Loading chart data...</span>
                    </div>
                </div>

                <!-- Timeframe Buttons Below Chart -->
                <div class="chart-footer">
                    <div class="chart-timeframes-bottom">
                        <button class="timeframe-btn-bottom active" data-days="1">1D</button>
                        <button class="timeframe-btn-bottom" data-days="7">1W</button>
                        <button class="timeframe-btn-bottom" data-days="30">1M</button>
                        <button class="timeframe-btn-bottom" data-days="90">3M</button>
                        <button class="timeframe-btn-bottom" data-days="180">6M</button>
                        <button class="timeframe-btn-bottom" data-days="365">1Y</button>
                        <button class="timeframe-btn-bottom" data-days="max">All</button>
                    </div>
                    <div class="chart-type-toggle">
                        <button class="chart-type-btn active" data-type="line">
                            <i class="fas fa-chart-line"></i>
                        </button>
                        <button class="chart-type-btn" data-type="candle">
                            Terminal <i class="fas fa-arrows-alt"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Performance Section -->
            <div class="performance-main-container card">
                <h3 class="performance-title">
                    Performance
                    <i class="fas fa-info-circle info-icon"></i>
                </h3>
                
                <!-- Today's Range -->
                <div class="price-range-section">
                    <div class="range-header">
                        <div class="range-label">Today's Low</div>
                        <div class="range-label">Today's High</div>
                    </div>
                    <div class="range-values">
                        <div class="range-value-start">{{formatPrice coin.low_24h}}</div>
                        <div class="range-slider">
                            <div class="slider-track">
                                <div class="slider-marker" style="left: {{calculateRangePosition coin.low_24h coin.current_price coin.high_24h}}%;">
                                    <div class="marker-triangle">▲</div>
                                </div>
                            </div>
                        </div>
                        <div class="range-value-end">{{formatPrice coin.high_24h}}</div>
                    </div>
                </div>

                <!-- 52 Week Range -->
                <div class="price-range-section">
                    <div class="range-header">
                        <div class="range-label">52W Low</div>
                        <div class="range-label">52W High</div>
                    </div>
                    <div class="range-values">
                        <div class="range-value-start">{{formatPrice coin.atl}}</div>
                        <div class="range-slider">
                            <div class="slider-track">
                                <div class="slider-marker" style="left: {{calculateRangePosition coin.atl coin.current_price coin.ath}}%;">
                                    <div class="marker-triangle">▲</div>
                                </div>
                            </div>
                        </div>
                        <div class="range-value-end">{{formatPrice coin.ath}}</div>
                    </div>
                </div>

                <!-- Divider -->
                <div class="performance-divider"></div>

                <!-- Additional Metrics Grid -->
                <div class="performance-metrics-grid">
                    <div class="performance-metric">
                        <div class="performance-metric-label">Open</div>
                        <div class="performance-metric-value">{{formatPrice coin.current_price}}</div>
                    </div>
                    <div class="performance-metric">
                        <div class="performance-metric-label">Prev. Close</div>
                        <div class="performance-metric-value">{{formatPrice coin.current_price}}</div>
                    </div>
                    <div class="performance-metric">
                        <div class="performance-metric-label">Volume</div>
                        <div class="performance-metric-value">{{formatNumber coin.total_volume}}</div>
                    </div>
                    <div class="performance-metric">
                        <div class="performance-metric-label">Total traded value</div>
                        <div class="performance-metric-value">${{formatNumber coin.market_cap}}</div>
                    </div>
                    <div class="performance-metric">
                        <div class="performance-metric-label">Upper Circuit</div>
                        <div class="performance-metric-value">{{formatPrice (multiply coin.current_price 1.2)}}</div>
                    </div>
                    <div class="performance-metric">
                        <div class="performance-metric-label">Lower Circuit</div>
                        <div class="performance-metric-value">{{formatPrice (multiply coin.current_price 0.8)}}</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column - Buy/Sell Panel -->
        <div class="detail-sidebar">
            <div class="trading-panel card">
                <div class="trading-tabs">
                    <button class="trading-tab active" data-action="buy">BUY</button>
                    <button class="trading-tab" data-action="sell">SELL</button>
                </div>

                {{#if user}}
                    <!-- Buy Form -->
                    <form id="buy-form" class="trading-form active" action="/crypto/buy" method="POST">
                        <input type="hidden" name="coinId" value="{{coin.id}}">
                        <input type="hidden" name="price" value="{{coin.current_price}}">

                        <div class="form-group">
                            <label class="form-label">
                                Qty
                                <select class="qty-type-select" id="qtyType">
                                    <option value="nse">NSE</option>
                                </select>
                            </label>
                            <input type="number" 
                                   name="quantity" 
                                   class="form-control-detail" 
                                   placeholder="0" 
                                   required 
                                   min="0.000001" 
                                   step="0.000001"
                                   id="buyQuantity">
                        </div>

                        <div class="form-group">
                            <label class="form-label">
                                Price
                                <button type="button" class="limit-dropdown">
                                    Limit <i class="fas fa-chevron-down"></i>
                                </button>
                            </label>
                            <div class="price-display">${{formatPrice coin.current_price}}</div>
                        </div>

                        <div class="order-type-buttons">
                            <button type="button" class="order-type-btn active" data-type="delivery">Delivery</button>
                            <button type="button" class="order-type-btn" data-type="intraday">Intraday</button>
                        </div>

                        <div class="balance-info">
                            <span>Balance:</span>
                            <span class="balance-amount">$15,626</span>
                        </div>

                        <div class="total-section">
                            <div class="total-label">Approx req:</div>
                            <div class="total-value" id="buyTotal">₹0</div>
                        </div>

                        <button type="submit" class="btn-trade btn-buy">Buy</button>
                    </form>

                    <!-- Sell Form -->
                    <form id="sell-form" class="trading-form" action="/crypto/sell" method="POST">
                        <input type="hidden" name="coinId" value="{{coin.id}}">
                        <input type="hidden" name="price" value="{{coin.current_price}}">

                        <div class="form-group">
                            <label class="form-label">
                                Qty
                                <select class="qty-type-select">
                                    <option value="nse">NSE</option>
                                </select>
                            </label>
                            <input type="number" 
                                   name="quantity" 
                                   class="form-control-detail" 
                                   placeholder="0" 
                                   required 
                                   min="0.000001" 
                                   step="0.000001"
                                   id="sellQuantity">
                        </div>

                        <div class="form-group">
                            <label class="form-label">
                                Price
                                <button type="button" class="limit-dropdown">
                                    Limit <i class="fas fa-chevron-down"></i>
                                </button>
                            </label>
                            <div class="price-display">${{formatPrice coin.current_price}}</div>
                        </div>

                        <div class="order-type-buttons">
                            <button type="button" class="order-type-btn active" data-type="delivery">Delivery</button>
                            <button type="button" class="order-type-btn" data-type="intraday">Intraday</button>
                        </div>

                        <div class="balance-info">
                            <span>Qty available:</span>
                            <span class="balance-amount">0</span>
                        </div>

                        <div class="total-section">
                            <div class="total-label">Approx returns:</div>
                            <div class="total-value" id="sellTotal">₹0</div>
                        </div>

                        <button type="submit" class="btn-trade btn-sell">Sell</button>
                    </form>
                {{else}}
                    <div class="login-prompt">
                        <i class="fas fa-lock"></i>
                        <p>Please login to start trading</p>
                        <a href="/auth/login" class="btn btn-primary">Login</a>
                    </div>
                {{/if}}
            </div>

            <!-- Market Status Card -->
            <div class="market-status-card card">
                <h4 class="card-small-title">Market Status</h4>
                <div class="status-indicator">
                    <div class="status-dot active"></div>
                    <span>Market Open</span>
                </div>
            </div>

            <!-- Quick Stats -->
            <div class="quick-stats-card card">
                <h4 class="card-small-title">Quick Stats</h4>
                <div class="quick-stat-row">
                    <span>24h Volume</span>
                    <span class="stat-value-small">${{formatNumber coin.total_volume}}</span>
                </div>
                <div class="quick-stat-row">
                    <span>Market Cap</span>
                    <span class="stat-value-small">${{formatNumber coin.market_cap}}</span>
                </div>
                {{#if coin.circulating_supply}}
                <div class="quick-stat-row">
                    <span>Circulating Supply</span>
                    <span class="stat-value-small">{{formatNumber coin.circulating_supply}}</span>
                </div>
                {{/if}}
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/js/crypto-detail.js"></script>
<script>
    // Pass coin data to JavaScript
    window.coinData = {
        id: '{{coin.id}}',
        name: '{{coin.name}}',
        symbol: '{{coin.symbol}}',
        currentPrice: {{coin.current_price}},
        chartData: {{{json chartData}}}
    };
</script>
